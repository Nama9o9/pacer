# Vorlage für supabase/functions/.env (lokal, wird nicht committet).
# Kopieren nach functions/.env und Werte eintragen.
# Produktion: npx supabase secrets set GEMINI_API_KEY=... (nicht hier eintragen)

# API-Key aus Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional, Standard: gemini-3.5-flash-lite
GEMINI_MODEL=
